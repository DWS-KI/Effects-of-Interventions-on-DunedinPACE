  title = {Age-Associated Changes in Hypothalamic--Pituitary--Testicular Function in Middle-Aged and Older Men Are Modified by Weight Change and Lifestyle Factors: Longitudinal Results from the {{European Male Ageing Study}}},
  shorttitle = {Age-Associated Changes in Hypothalamic--Pituitary--Testicular Function in Middle-Aged and Older Men Are Modified by Weight Change and Lifestyle Factors},
  author = {Camacho, E M and Huhtaniemi, I T and O'Neill, T W and Finn, J D and Pye, S R and Lee, D M and Tajar, A and Bartfai, G and Boonen, S and Casanueva, F F and Forti, G and Giwercman, A and Han, T S and Kula, K and Keevil, B and Lean, M E and Pendleton, N and Punab, M and Vanderschueren, D and Wu, F C W and {the EMAS Group}},
  year = 2013,
